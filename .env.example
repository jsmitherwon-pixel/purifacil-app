# Base URL for the Purifácil backend. Any Expo env var prefixed with
# EXPO_PUBLIC_ is exposed to the app at build time.
EXPO_PUBLIC_API_BASE=https://api.purifacil.mx

# Toggle the in-app mock adapter. Leave true while the backend is being
# built; set to "false" to hit the real API defined above.
EXPO_PUBLIC_USE_MOCK_API=true
